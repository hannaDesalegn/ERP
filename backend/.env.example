# Copy to .env and fill in. .env is never committed.

# MongoDB connection string
MONGO_URI=

# Secret for signing access tokens. Long random string, not a word.
JWT_SECRET=

# Port the API listens on. Vite's dev proxy targets 8000.
PORT=8000

# Exact browser origin allowed by CORS. Never "*" — a cookie is involved.
CORS_ORIGIN=http://localhost:5173

# Passwords for the three test accounts, used by `npm run seed` when it creates
# them and by src/smokeOperations.js when it signs in as them. Never commit
# values here — this file is the template, .env is the one that is ignored.
#
# The seed only creates missing accounts, so changing these does not rotate a
# password that is already set. To rotate, use PATCH /api/auth/password.
TEST_ADMIN_PASSWORD=
TEST_MANAGER_PASSWORD=
TEST_STAFF_PASSWORD=
