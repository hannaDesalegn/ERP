# Copy to .env and fill in. .env is never committed.

# MongoDB connection string
MONGO_URI=

# Secret for signing access tokens. Long random string, not a word.
JWT_SECRET=

# Port the API listens on. Vite's dev proxy targets 8000.
PORT=8000

# Exact browser origin allowed by CORS. Never "*" — a cookie is involved.
CORS_ORIGIN=http://localhost:5173
