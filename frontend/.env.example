# Copy to .env and adjust. .env is gitignored; this file is committed.
#
# WARNING: anything prefixed VITE_ is compiled into the public bundle and is
# readable by any user in devtools. Never put a secret, key, or credential here.
# See docs/security-notes.md § Nothing secret in the bundle.

# Base path for all API calls. The Vite dev server proxies this.
VITE_API_BASE_URL=/api

# true  → MSW intercepts /api in the browser (no backend needed)
# false → requests go through the Vite proxy to VITE_API_PROXY_TARGET
VITE_USE_MOCKS=true

# Where the dev proxy forwards /api when VITE_USE_MOCKS=false.
VITE_API_PROXY_TARGET=http://localhost:8000

# Shown in the shell so nobody demos against the wrong environment.
VITE_APP_ENV=development
